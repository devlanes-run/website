{
  "name": "@devlanes/website",
  "version": "0.0.0",
  "private": true,
  "description": "The devlanes.run website",
  "homepage": "https://devlanes.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlanes-run/website.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm sync && astro build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "dev": "pnpm sync && astro dev",
    "format": "biome format --write . && prettier --write \"src/**/*.{astro,scss}\"",
    "lint": "biome check . && prettier --check \"src/**/*.{astro,scss}\"",
    "lint-ci": "biome ci . && prettier --check \"src/**/*.{astro,scss}\"",
    "lint-fix": "biome check --write --unsafe . && prettier --write \"src/**/*.{astro,scss}\"",
    "preview": "astro preview",
    "sync": "node scripts/sync.mjs",
    "test": "node --test scripts/*.test.mjs integrations/*.test.mjs && playwright test",
    "test-types": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "astro": "^7.4.4",
    "astro-compress": "^2.4.3",
    "astro-icon": "^1.2.0",
    "defuddle": "^0.19.6",
    "linkedom": "^0.18.15",
    "three": "^0.187.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  }
}
