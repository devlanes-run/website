---
import BetaBanner from '../components/BetaBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Analytics from '../components/head/Analytics.astro';
import Fonts from '../components/head/Fonts.astro';
import ThemeInit from '../components/head/ThemeInit.astro';
import Road from '../components/Road.astro';
import '../styles/global.scss';

interface Props {
  /** Page title; the site name is appended. The landing page passes none. */
  title?: string;
  description?: string;
  /** Path of this page, for the canonical URL. */
  path?: string;
  current?: 'lanes' | 'remote' | 'agents';
}

const tagline = 'Run every worktree at once, each on its own localhost.';
const {
  title,
  description = 'devlanes is an open source CLI and daemon that runs your dev stack once per Git worktree, each with its own ports, hostnames and database, on your own machine or mirrored from a box over ssh.',
  path = '/',
  current
} = Astro.props;
const pageTitle = title ? `${title} | devlanes` : `devlanes: ${tagline}`;
const canonical = `https://devlanes.run${path}`;
const socialDescription = 'An open source CLI that runs your dev stack once per Git worktree.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://devlanes.run/#website',
      name: 'devlanes',
      url: 'https://devlanes.run/',
      description,
      inLanguage: 'en',
      sameAs: 'https://github.com/devlanes-run/devlanes'
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://devlanes.run/#software',
      name: 'devlanes',
      url: 'https://devlanes.run/',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      isAccessibleForFree: true,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      description:
        'devlanes runs a dev stack once per Git worktree, with separate ports, hostnames and data for each lane, kept running by a per-user daemon.',
      sameAs: 'https://github.com/devlanes-run/devlanes'
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2ef" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {path === '/' && <link rel="alternate" type="text/markdown" href="/index.md" />}
    <link rel="help" type="text/plain" href="/llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="devlanes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ?? tagline} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content="https://devlanes.run/social.png" />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1120" />
    <meta property="og:image:alt" content={`devlanes: ${tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? tagline} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content="https://devlanes.run/social.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeInit />
    <Analytics />
    <Fonts />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Road />
    <BetaBanner />
    {Astro.slots.has('sign') && (
      <div class="sign">
        <div class="page">
          <Header {...(current ? { current } : {})} />
          <slot name="sign" />
        </div>
      </div>
    )}
    <div class="page">
      {!Astro.slots.has('sign') && <Header {...(current ? { current } : {})} />}
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
