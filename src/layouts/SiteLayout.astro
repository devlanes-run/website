---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Analytics from '../components/head/Analytics.astro';
import Fonts from '../components/head/Fonts.astro';
import ThemeInit from '../components/head/ThemeInit.astro';
import Road from '../components/Road.astro';
import '../styles/global.scss';

const title = 'devlanes | Sandboxes for your agents. localhost for you.';
const description =
  'Run multiple development stacks locally or on a remote machine and access them through localhost.';
const socialTitle = 'Sandboxes for your agents. localhost for you.';
const socialDescription = 'Parallel development stacks with local access.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://devlanes.run/#website',
      name: 'devlanes',
      url: 'https://devlanes.run/',
      description,
      inLanguage: 'en',
      sameAs: 'https://github.com/devlanes-run/devlanes'
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://devlanes.run/#software',
      name: 'devlanes',
      url: 'https://devlanes.run/',
      applicationCategory: 'DeveloperApplication',
      description:
        'devlanes manages development stacks on local and remote machines, with separate ports and data for each lane.',
      sameAs: 'https://github.com/devlanes-run/devlanes'
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2ef" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://devlanes.run/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="help" type="text/plain" href="/llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://devlanes.run/" />
    <meta property="og:site_name" content="devlanes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content="https://devlanes.run/social.png" />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1120" />
    <meta
      property="og:image:alt"
      content="devlanes: Sandboxes for your agents. localhost for you. Parallel development stacks."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content="https://devlanes.run/social.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeInit />
    <Analytics />
    <Fonts />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Road />
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
