---
import { domain, lanes, total } from '../data/demo';
import Install from './Install.astro';
import LaneView from './LaneView.astro';
import Terminal from './Terminal.astro';
import TerminalTabs from './TerminalTabs.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">
    <span>Sandboxes for your agents.</span> <span>localhost for you.</span>
  </h1>
  <p class="intro">
    Run multiple copies of your development stack locally or on a remote machine, and access each
    through localhost.
  </p>
  <Install />
  <div class="actions">
    <a
      class="button"
      href="https://github.com/devlanes-run/devlanes/tree/main/docs"
      target="_blank"
      rel="noopener noreferrer"
    >
      Read the docs
    </a>
    <a class="button" href="#lanes">
      About lanes
    </a>
  </div>
  <Terminal title="devlanes / myapp">
    <TerminalTabs
      label="Ways to see the lanes"
      tabs={[
        { id: 'hero-status', label: 'devlanes status' },
        { id: 'hero-tui', label: 'devlanes (TUI)' }
      ]}
    />
    <div id="hero-status">
      <p class="terminal-line command">$ devlanes status</p>
      <div
        class="table-scroll"
        role="region"
        aria-label="Example lanes, scroll horizontally for all columns"
        tabindex="0"
      >
        <table class="lane-table">
          <caption>myapp</caption>
          <thead>
            <tr>
              <th>LANE</th>
              <th>BRANCH</th>
              <th>STATE</th>
              <th>SERVICES</th>
              <th>CPU</th>
              <th>MEM</th>
              <th>URL</th>
            </tr>
          </thead>
          <tbody>
            {lanes.map(({ index, branch, units }) => (
              <tr>
                <td>
                  <span class={`lane-mark lane-${index}`} />
                  {index}
                </td>
                <th scope="row">{branch}</th>
                {units.length ? (
                  <>
                    <td class="state-ready">running</td>
                    <td>
                      {units.length}/{units.length}
                    </td>
                    <td>{total(units, 'cpu').toFixed(1)}%</td>
                    <td>{total(units, 'mem').toFixed(1)} MiB</td>
                  </>
                ) : (
                  <>
                    <td class="tui-dim">idle</td>
                    <td>–</td>
                    <td>–</td>
                    <td>–</td>
                  </>
                )}
                <td>https://{domain(index)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div id="hero-tui" hidden>
      <LaneView lane={1} unit="api" />
    </div>
  </Terminal>
  <p class="caption">Each lane has its own ports, hostnames and data.</p>
</section>
