---
import Install from './Install.astro';
import RoadScene from './RoadScene.astro';
---

<RoadScene />
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">Run every worktree at once, each on its own localhost.</h1>
  <p class="hero-lede">
    Stop fighting over port 3000. Each worktree gets its own ports, hostnames and databases, even
    when it runs on a box in the cloud.
  </p>
  <Install />
</section>
