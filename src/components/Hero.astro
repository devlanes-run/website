---
import Install from './Install.astro';
import RoadScene from './RoadScene.astro';
---

<RoadScene />
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">Run every worktree at once, each on its own localhost.</h1>
  <p class="hero-lede">
    Stop fighting over port 3000. devlanes runs your dev stack per Git worktree: own ports, own{' '}
    <code>https://myapp1.localhost</code>, own databases. One terminal shows every lane and its
    logs, and coding agents get lanes of their own.
  </p>
  <Install />
</section>
<span class="sign-credit">Car models by Kenney, CC0</span>
