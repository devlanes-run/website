---
import { Icon } from 'astro-icon/components';
import Mark from './Mark.astro';

interface Props {
  current?: 'docs' | 'lanes' | 'remote' | 'agents';
}
const { current } = Astro.props;
const page = (name: Props['current']) => (current === name ? 'page' : undefined);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="devlanes home">
    <Mark />
    devlanes
  </a>
  <nav aria-label="Main navigation">
    <a href="/lanes/" aria-current={page('lanes')}>
      Lanes
    </a>
    <a href="/remote/" aria-current={page('remote')}>
      Remote
    </a>
    <a href="/agents/" aria-current={page('agents')}>
      Agents
    </a>
    <a href="/docs/" aria-current={page('docs')}>
      Docs
    </a>
    <a
      class="github-link"
      href="https://github.com/devlanes-run/devlanes"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="mdi:github" size={18} aria-hidden="true" />
      GitHub
    </a>
  </nav>
  <div class="preferences">
    <slot name="search" />
    <button
      id="theme"
      type="button"
      aria-label="Switch to dark theme"
      title="Switch to dark theme"
      hidden
    >
      <Icon class="theme-moon" name="mdi:weather-night" size={20} aria-hidden="true" />
      <Icon class="theme-sun" name="mdi:weather-sunny" size={20} aria-hidden="true" />
    </button>
  </div>
</header>

<script>
  import '../scripts/theme';
</script>
