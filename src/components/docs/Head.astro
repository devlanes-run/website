---
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '../head/Analytics.astro';
import Fonts from '../head/Fonts.astro';

const { id } = Astro.locals.starlightRoute;
// Every docs page has a Markdown twin generated by src/pages/[...slug].md.ts.
const markdown = id === '404' ? undefined : `/${id}.md`;
---

<Default />
<meta name="theme-color" content="#f2f2ef" />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
<link rel="help" type="text/plain" href="/llms.txt" />
<Analytics />
<Fonts />
