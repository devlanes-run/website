---
import Mark from './Mark.astro';
import Terminal from './Terminal.astro';
import TerminalTabs from './TerminalTabs.astro';

// Commands and output follow devlanes' agent-mode output, which is what an agent reads.
const scenes = [
  {
    id: 'agent-start',
    title: 'Start a lane',
    prompt: 'Start the checkout branch so I can test it.',
    command: '$ devlanes start --lane feat/checkout',
    output: [
      'myapp@1 (feat/checkout): 3/3 ready',
      'ready api http://127.0.0.1:20010 https://api.myapp-1.localhost',
      'ready web http://127.0.0.1:20011 https://myapp-1.localhost',
      'ready worker http://127.0.0.1:20012'
    ],
    reply:
      'The checkout stack is running next to main. Open https://myapp-1.localhost on your laptop to try it.'
  },
  {
    id: 'agent-logs',
    title: 'Read the logs',
    prompt: 'Submitting the form returns a 500. Find out why.',
    command: '$ devlanes logs api --lane feat/checkout --grep error',
    output: ['api#57 error: column "orders.coupon_code" does not exist'],
    reply:
      'The orders table is missing coupon_code. I will add the migration and retry in this lane.'
  },
  {
    id: 'agent-with',
    title: 'Run the tests',
    prompt: 'Run the end-to-end tests against the fix.',
    command: '$ devlanes with --lane feat/checkout -- pnpm test:e2e',
    output: ['myapp@1 (feat/checkout): 3/3 ready', '42 passed (38.2s)'],
    reply:
      "All 42 tests passed against this lane's own ports and hostnames. The tests read them from the lane's environment."
  },
  {
    id: 'agent-clean',
    title: 'Clean up',
    prompt: 'Looks good. Clean up this lane.',
    command: '$ devlanes lane clean feat/checkout --yes',
    output: ['cleaned myapp@1: stopped 3 units, teardown database'],
    reply: 'The checkout lane is stopped, its database is dropped and its ports are free again.'
  }
];
---

<section id="agents" class="feature split agent-section" aria-labelledby="agents-title">
  <div class="copy">
    <h2 id="agents-title">Give your agent a lane</h2>
    <p>
      An agent can start a stack for its changes and give you a localhost URL to test. It uses the
      same commands you use to inspect logs or stop services.
    </p>
    <p>The daemon keeps services running when a terminal session ends.</p>
    <p class="small">
      A lane groups processes and data. The machine or container running them defines the security
      boundary.
    </p>
  </div>
  <Terminal title="agent session / myapp">
    <div class="agent-head">
      <Mark size={42} />
      <div>
        your agent<small>your AI model / ~/dev/myapp</small>
      </div>
    </div>
    <TerminalTabs
      label="Agent workflow examples"
      tabs={scenes.map(({ id, title }) => ({ id, label: title }))}
    />
    {scenes.map((scene, index) => (
      <div class="scene" id={scene.id} hidden={index !== 0}>
        <p class="agent-prompt">{scene.prompt}</p>
        <div class="scene-body">
          <p class="command">{scene.command}</p>
          <p class="output">
            {scene.output.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </p>
          <p>{scene.reply}</p>
        </div>
      </div>
    ))}
  </Terminal>
</section>
