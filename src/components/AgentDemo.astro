---
import Mark from './Mark.astro';
import Terminal from './Terminal.astro';

const scenes = [
  {
    title: 'Start a lane',
    prompt: 'Start the checkout branch so I can test it.',
    command: '$ devlanes up --lane feat/checkout',
    output: 'lane 1 ready / web :21000 / api :21001 / db myapp_lane1',
    reply:
      'The checkout stack is running alongside main. Open https://myapp-1.localhost on your laptop to try it.'
  },
  {
    title: 'Read the logs',
    prompt: 'Submitting the form returns a 500. Find out why.',
    command: '$ devlanes logs api --lane 1',
    output: 'error: column "orders.coupon_code" does not exist',
    reply: 'The orders table is missing coupon_code. I will add the migration and retry in lane 1.'
  },
  {
    title: 'Clean up',
    prompt: 'Looks good. Clean up this lane.',
    command: '$ devlanes lane clean feat/checkout',
    output: 'stopped 3 services / removed myapp_lane1 / released ports',
    reply: 'The checkout lane is gone. Main is still running at https://myapp.localhost.'
  }
];
---

<section id="agents" class="feature split agent-section" aria-labelledby="agents-title">
  <div class="copy">
    <h2 id="agents-title">Give your agent a lane</h2>
    <p>
      An agent can start a stack for its changes and give you a localhost URL to test. It uses the
      same commands you use to inspect logs or stop services.
    </p>
    <p>The daemon keeps services running when a terminal session ends.</p>
    <p class="small">
      A lane groups processes and data. The machine or container running them defines the security
      boundary.
    </p>
  </div>
  <Terminal title="agent session / myapp">
    <div class="agent-head">
      <Mark size={42} />
      <div>
        your agent<small>your AI model / ~/dev/myapp</small>
      </div>
    </div>
    <div class="scene-controls" role="group" aria-label="Agent workflow examples" hidden>
      {scenes.map((scene, index) => (
        <button
          type="button"
          data-scene={index}
          aria-pressed={index === 0}
          aria-controls={`scene-${index}`}
          hidden
        >
          {scene.title}
        </button>
      ))}
    </div>
    {scenes.map((scene, index) => (
      <div class="scene" id={`scene-${index}`} hidden={index !== 0}>
        <p class="agent-prompt">{scene.prompt}</p>
        <div class="scene-body">
          <p class="command">{scene.command}</p>
          <p class="output">{scene.output}</p>
          <p>{scene.reply}</p>
        </div>
      </div>
    ))}
  </Terminal>
</section>
