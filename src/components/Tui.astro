---
// The live TUI: the real devlanes TUI compiled to WebAssembly, sized in cells of its font by
// src/scripts/tui.ts. The static monitor (following crates/tui/screens/monitor-* in the devlanes
// repository) stays without JavaScript, without the bundle under /tui/ or when the module throws.
// The page wraps this in a Terminal window; the screen's background is transparent and the
// badge sits in the window's title bar once the live TUI is up.
import { lanes, total, type Unit } from '../data/demo';

interface Props {
  /** Rows of the live grid on desktop. */
  rows?: number;
  /** Rows of the live grid under 720px. */
  mobileRows?: number;
  /** The `KeyboardEvent.key` sent once mounted; uppercase letters are sent with Shift. */
  view?: string;
  /** Unused by the markup: the window title belongs to the surrounding Terminal. */
  title?: string;
  id?: string;
}

const { rows = 34, mobileRows = 26, view = 'M', id = 'tui-demo' } = Astro.props;

const running = lanes.filter((lane) => lane.units.length);
const count = running.reduce((sum, lane) => sum + lane.units.length, 0);
const cpu = total(
  running.flatMap((lane) => lane.units),
  'cpu'
);
const mem = total(
  running.flatMap((lane) => lane.units),
  'mem'
);
const sorted = (units: Unit[]) => [...units].sort((a, b) => b.cpu - a.cpu);
// Four cells per bar, like the TUI; the scale tops out at 40% CPU and 300 MiB.
const bar = (value: number, max: number) => Math.max(1, Math.min(4, Math.round((value / max) * 4)));
const spark = '▂▃▃▄▃▄▅▄▃▄▅▆▅▄▄▅▄▃▄▅';
---

<div class="tui" data-tui data-rows={rows} data-mobile-rows={mobileRows} data-view={view}>
  <span class="tui-badge" data-tui-badge hidden>
    <i aria-hidden="true"></i>
    <span data-tui-badge-text>Live, click to interact</span>
  </span>
  <div class="tui-static" data-tui-static>
    <div class="tui-top">
      <strong>devlanes</strong>
      <span>1 myapp</span>
      <span class="tui-keys">
        <b>M</b> monitor <b>D</b> daemon
      </span>
    </div>
    <div class="tui-usage">
      <span>
        <span class="tui-dim">cpu</span> <span class="state-ready">{spark}</span> {cpu.toFixed(0)}%
      </span>
      <span>
        <span class="tui-dim">mem</span> {(mem / 1024).toFixed(1)}G
      </span>
    </div>
    <div class="tui-pane">
      <p class="tui-title">
        units {count} of {count} · by lane <span class="tui-dim">&lt;- cpu -&gt;</span>
      </p>
      <div
        class="table-scroll"
        role="region"
        aria-label="Units by lane, scroll horizontally for all columns"
        tabindex="0"
      >
        <table class="monitor-table">
          <thead>
            <tr>
              <th>name</th>
              <th>state</th>
              <th>cpu ▼</th>
              <th>mem</th>
              <th>uptime</th>
            </tr>
          </thead>
          {running.map(({ index, branch, units }) => (
            <tbody>
              <tr class="monitor-lane">
                <th scope="rowgroup">
                  ▾ myapp@{index} <span>{branch}</span>
                </th>
                <td />
                <td>{total(units, 'cpu').toFixed(1)}%</td>
                <td>{total(units, 'mem')}M</td>
                <td />
              </tr>
              {sorted(units).map((unit) => (
                <tr class={index === 3 && unit.name === 'api' ? 'tui-selected' : undefined}>
                  <th scope="row">
                    <span class={`state-${unit.state}`}>{unit.state === 'ready' ? '●' : '◉'}</span>{' '}
                    {unit.name}
                  </th>
                  <td>{unit.state}</td>
                  <td>
                    {unit.cpu.toFixed(1)}%{' '}
                    <span class="bar" aria-hidden="true">
                      <i>{'■'.repeat(bar(unit.cpu, 40))}</i>
                      {'■'.repeat(4 - bar(unit.cpu, 40))}
                    </span>
                  </td>
                  <td>
                    {unit.mem}M{' '}
                    <span class="bar" aria-hidden="true">
                      <i>{'■'.repeat(bar(unit.mem, 300))}</i>
                      {'■'.repeat(4 - bar(unit.mem, 300))}
                    </span>
                  </td>
                  <td>{unit.uptime}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
    <div class="terminal-foot">
      j k move <span>enter open unit</span> <span>&lt; &gt; sort</span> <span>/ filter</span>
      <span>? all keys</span> <span>q quit</span>
    </div>
  </div>
  <div class="tui-live" data-tui-live hidden>
    <div
      class="tui-screen"
      id={id}
      tabindex="0"
      role="application"
      aria-label="The devlanes terminal, live"
    ></div>
    <p class="tui-hint" data-tui-hint aria-hidden="true" hidden>
      <span>Click to interact</span>
    </p>
  </div>
</div>

<script>
  import '../scripts/tui';
</script>
