---
// The live TUI: the real devlanes TUI compiled to WebAssembly, sized in cells of its font by
// src/scripts/tui.ts. Until it mounts, and without JavaScript or the bundle under /tui/, the
// window holds an empty screen of the same height. The page wraps this in a Terminal window;
// the badge sits in the window's title bar once the live TUI is up.
interface Props {
  /** Rows of the live grid on desktop. */
  rows?: number;
  /** Rows of the live grid under 720px. */
  mobileRows?: number;
  /** The `KeyboardEvent.key` sent once mounted; uppercase letters are sent with Shift. */
  view?: string;
  /** Unused by the markup: the window title belongs to the surrounding Terminal. */
  title?: string;
  id?: string;
}

const { rows = 34, mobileRows = 26, view = 'M', id = 'tui-demo' } = Astro.props;
---

<div class="tui" data-tui data-rows={rows} data-mobile-rows={mobileRows} data-view={view}>
  <span class="tui-badge" data-tui-badge hidden>
    <i aria-hidden="true"></i>
    <span data-tui-badge-text>Live, click to interact</span>
  </span>
  <div class="tui-static" data-tui-static></div>
  <div class="tui-live" data-tui-live hidden>
    <div
      class="tui-screen"
      id={id}
      tabindex="0"
      role="application"
      aria-label="The devlanes terminal, live"
    ></div>
    <p class="tui-hint" data-tui-hint aria-hidden="true" hidden>
      <span>Click to interact</span>
    </p>
  </div>
</div>

<script>
  import '../scripts/tui';
</script>
