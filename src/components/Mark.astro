---
// Inlined as an SVG component rather than an astro-icon: that renders through <use>, where the
// header's override for the yellow bar (src/styles/_header.scss) cannot reach the rects.
import Devlanes from '../icons/devlanes.svg';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<Devlanes width={size} height={size} aria-hidden="true" />
