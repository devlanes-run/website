---
const services = ['web', 'api', 'worker'] as const;
const tracks = [-2, -1, 1, 2];
---

<div class="road" aria-hidden="true" data-road>
  <div class="road-markings"></div>
  <div class="traffic" data-road-traffic>
    {tracks.map((track, group) =>
      services.map((service, index) => (
        <div
          class={`vehicle convoy-${group}`}
          data-track={track}
          data-group={group}
          data-service={index}
          style={`--lane-offset:${Math.sign(track) * (Math.abs(track) - 0.5)};top:${8 + group * 21 + index * 6}%`}
        >
          <svg viewBox="-16 -16 32 32" width="32" height="32" focusable="false">
            {service === 'web' && (
              <>
                <rect x="-14" y="-11" width="28" height="22" rx="3" />
                <path d="M-14-4H14M-9-7.5h2" />
              </>
            )}
            {service === 'api' && (
              <path d="M-5-13H-8V-5L-12 0L-8 5V13H-5M5-13H8V-5L12 0L8 5V13H5" />
            )}
            {service === 'worker' && (
              <>
                <rect x="-14" y="-11" width="28" height="22" rx="3" />
                <path d="M-8-5L-3 0L-8 5M2 5H9" />
              </>
            )}
          </svg>
          <span>{service}</span>
        </div>
      ))
    )}
  </div>
</div>

<script>
  import '../scripts/road';
</script>

<style lang="scss">
  :global(:root) {
    --lane-width: 160px;
  }

  .road {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .road-markings {
    position: fixed;
    inset: -76px 0;
    transform: translateY(var(--road-scroll, 0px));
  }

  .road-markings::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      90deg,
      transparent calc(50% - 1px),
      var(--road-line, #d5d1c8) calc(50% - 1px) calc(50% + 1px),
      transparent calc(50% + 1px)
    );
    background-size: var(--lane-width) 100%;
    background-position: center;
    mask-image: repeating-linear-gradient(0deg, transparent 0 32px, #000 32px 76px);
  }

  .road-markings::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 50%;
    width: 10px;
    margin-left: -5px;
    background: linear-gradient(
      90deg,
      var(--road-centre, #c4a350) 0 3px,
      var(--surface, #f7f5ef) 3px 7px,
      var(--road-centre, #c4a350) 7px 10px
    );
  }

  .traffic {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .vehicle {
    position: absolute;
    left: calc(50% + var(--lane-offset) * var(--lane-width));
    width: 64px;
    margin-left: -32px;
    display: grid;
    justify-items: center;
    gap: 3px;
    opacity: 0.72;
    font:
      11px/1.2 'JetBrains Mono',
      ui-monospace,
      monospace;
  }

  .vehicle svg {
    fill: var(--surface, #f7f5ef);
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vehicle path {
    fill: none;
  }

  .convoy-0 {
    color: #a87918;
  }
  .convoy-1 {
    color: #527caa;
  }
  .convoy-2 {
    color: #8871aa;
  }
  .convoy-3 {
    color: #418886;
  }
  :global([data-theme='dark']) .convoy-0 {
    color: #c4a350;
  }
  :global([data-theme='dark']) .convoy-1 {
    color: #7c9fc6;
  }
  :global([data-theme='dark']) .convoy-2 {
    color: #a494be;
  }
  :global([data-theme='dark']) .convoy-3 {
    color: #78aaa7;
  }

  @media (max-width: 600px) {
    :global(:root) {
      --lane-width: 100px;
    }
    .traffic {
      opacity: 0.6;
    }
  }
</style>
