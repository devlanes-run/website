---
// The road's centre stroke runs down the whole page behind the content. Blocks have opaque
// surfaces, so it only shows in the gaps between them.
---

<div class="road" aria-hidden="true"></div>

<script>
  import '../scripts/motion';
</script>

<style lang="scss">
  .road {
    position: fixed;
    inset: 0 auto 0 50%;
    z-index: 0;
    width: 10px;
    margin-left: -5px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--road-centre) 0 3px,
      var(--surface) 3px 7px,
      var(--road-centre) 7px 10px
    );
  }
</style>
