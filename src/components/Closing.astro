---
import Mark from './Mark.astro';
---

<section class="closing copy" aria-labelledby="closing-title">
  <Mark size={48} />
  <h2 id="closing-title">Development is on GitHub</h2>
  <p>Read the source and track current work in the project repository.</p>
  <a
    class="button primary"
    href="https://github.com/devlanes-run/devlanes"
    target="_blank"
    rel="noopener noreferrer"
  >
    View repository
  </a>
</section>
