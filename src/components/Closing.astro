---
import Mark from './Mark.astro';
---

<section class="closing copy" aria-labelledby="closing-title">
  <Mark size={48} />
  <h2 id="closing-title">Still building. Follow along.</h2>
  <p>
    devlanes is in early development and is not ready to use. Follow the project as it takes shape.
  </p>
  <a
    class="button primary"
    href="https://github.com/devlanes-run"
    target="_blank"
    rel="noopener noreferrer"
  >
    Find devlanes on GitHub
  </a>
</section>
