---
interface Props {
  title: string;
  /** Extra class on the window, for size variants. */
  class?: string;
}
const { title, class: extra } = Astro.props;
---

<div class:list={['terminal', extra]}>
  <div class="terminal-bar">
    <span class="terminal-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="terminal-title">{title}</span>
  </div>
  <slot />
</div>
