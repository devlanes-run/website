---
// The TUI's monitor (M), following crates/tui/screens/monitor-* in the devlanes repository.
// It stays as the fallback without JavaScript or the TUI web build; scripts/monitor.ts swaps
// in the live TUI when /tui/devlanes_tui_web.js loads.
import { lanes, total, type Unit } from '../data/demo';
import Terminal from './Terminal.astro';

const running = lanes.filter((lane) => lane.units.length);
const count = running.reduce((sum, lane) => sum + lane.units.length, 0);
const cpu = total(
  running.flatMap((lane) => lane.units),
  'cpu'
);
const mem = total(
  running.flatMap((lane) => lane.units),
  'mem'
);
const sorted = (units: Unit[]) => [...units].sort((a, b) => b.cpu - a.cpu);
// Four cells per bar, like the TUI; the scale tops out at 40% CPU and 300 MiB.
const bar = (value: number, max: number) => Math.max(1, Math.min(4, Math.round((value / max) * 4)));
const spark = '▂▃▃▄▃▄▅▄▃▄▅▆▅▄▄▅▄▃▄▅';
// For touch screens, which have no keyboard to type into the live demo. `key` is the
// KeyboardEvent.key value the TUI receives.
const keys = [
  { label: 'j', key: 'j' },
  { label: 'k', key: 'k' },
  { label: 'Enter', key: 'Enter' },
  { label: 'Esc', key: 'Escape' },
  { label: 'M', key: 'M', shift: true },
  { label: 'Tab', key: 'Tab' },
  { label: '?', key: '?', shift: true }
];
---

<section id="monitor" class="feature" aria-labelledby="monitor-title">
  <div class="section-heading copy">
    <h2 id="monitor-title">Manage services from one terminal</h2>
    <p>
      See CPU and memory per lane and unit, including what agents started. Open a unit to read its
      output, type into it, stop it or restart it.
    </p>
  </div>
  <div data-monitor-static>
    <Terminal title="devlanes / myapp">
      <div class="tui">
        <div class="tui-top">
          <strong>devlanes</strong>
          <span>1 myapp</span>
          <span class="tui-keys">
            <b>M</b> monitor <b>D</b> daemon
          </span>
        </div>
        <div class="tui-usage">
          <span>
            <span class="tui-dim">cpu</span> <span class="state-ready">{spark}</span>{' '}
            {cpu.toFixed(0)}%
          </span>
          <span>
            <span class="tui-dim">mem</span> {(mem / 1024).toFixed(1)}G
          </span>
        </div>
        <div class="tui-pane">
          <p class="tui-title">
            units {count} of {count} · by lane <span class="tui-dim">&lt;- cpu -&gt;</span>
          </p>
          <div
            class="table-scroll"
            role="region"
            aria-label="Units by lane, scroll horizontally for all columns"
            tabindex="0"
          >
            <table class="monitor-table">
              <thead>
                <tr>
                  <th>name</th>
                  <th>state</th>
                  <th>cpu ▼</th>
                  <th>mem</th>
                  <th>uptime</th>
                </tr>
              </thead>
              {running.map(({ index, branch, units }) => (
                <tbody>
                  <tr class="monitor-lane">
                    <th scope="rowgroup">
                      ▾ myapp@{index} <span>{branch}</span>
                    </th>
                    <td />
                    <td>{total(units, 'cpu').toFixed(1)}%</td>
                    <td>{total(units, 'mem')}M</td>
                    <td />
                  </tr>
                  {sorted(units).map((unit) => (
                    <tr class={index === 3 && unit.name === 'api' ? 'tui-selected' : undefined}>
                      <th scope="row">
                        <span class={`state-${unit.state}`}>
                          {unit.state === 'ready' ? '●' : '◉'}
                        </span>{' '}
                        {unit.name}
                      </th>
                      <td>{unit.state}</td>
                      <td>
                        {unit.cpu.toFixed(1)}%{' '}
                        <span class="bar" aria-hidden="true">
                          <i>{'■'.repeat(bar(unit.cpu, 40))}</i>
                          {'■'.repeat(4 - bar(unit.cpu, 40))}
                        </span>
                      </td>
                      <td>
                        {unit.mem}M{' '}
                        <span class="bar" aria-hidden="true">
                          <i>{'■'.repeat(bar(unit.mem, 300))}</i>
                          {'■'.repeat(4 - bar(unit.mem, 300))}
                        </span>
                      </td>
                      <td>{unit.uptime}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
        </div>
        <div class="terminal-foot">
          j k move <span>enter open unit</span> <span>&lt; &gt; sort</span> <span>/ filter</span>
          <span>? all keys</span> <span>q quit</span>
        </div>
      </div>
    </Terminal>
  </div>
  <div class="monitor-live" data-monitor-live hidden>
    <p class="monitor-hint" id="tui-demo-hint">
      Click the terminal and type, or use the keys below: j and k move, Enter opens a unit, M opens
      the monitor and ? lists all keys.
    </p>
    <Terminal title="devlanes / myapp">
      <div class="tui-live-viewport">
        <div
          id="tui-demo"
          class="tui-live"
          tabindex="0"
          role="application"
          aria-label="Interactive demo of the devlanes terminal UI"
          aria-describedby="tui-demo-hint"
        ></div>
      </div>
    </Terminal>
    <div class="tui-hint-keys" role="group" aria-label="Keys for the demo">
      {keys.map(({ label, key, shift }) => (
        <button type="button" data-key={key} data-shift={shift ? 'true' : undefined}>
          {label}
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/monitor';
</script>
