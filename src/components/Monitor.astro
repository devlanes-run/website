---
// The TUI's monitor (M) follows crates/tui/screens/monitor-*; the lane view follows lanes-unit-*.
import { lanes, total, type Unit } from '../data/demo';
import LaneView from './LaneView.astro';
import Terminal from './Terminal.astro';
import TerminalTabs from './TerminalTabs.astro';

const running = lanes.filter((lane) => lane.units.length);
const count = running.reduce((sum, lane) => sum + lane.units.length, 0);
const cpu = total(
  running.flatMap((lane) => lane.units),
  'cpu'
);
const mem = total(
  running.flatMap((lane) => lane.units),
  'mem'
);
const sorted = (units: Unit[]) => [...units].sort((a, b) => b.cpu - a.cpu);
// Four cells per bar, like the TUI; the scale tops out at 40% CPU and 300 MiB.
const bar = (value: number, max: number) => Math.max(1, Math.min(4, Math.round((value / max) * 4)));
const spark = '▂▃▃▄▃▄▅▄▃▄▅▆▅▄▄▅▄▃▄▅';
---

<section id="monitor" class="feature" aria-labelledby="monitor-title">
  <div class="section-heading copy">
    <h2 id="monitor-title">Manage services from one terminal</h2>
    <p>
      See CPU and memory per lane and unit, including what agents started. Open a unit to read its
      output, type into it, stop it or restart it.
    </p>
  </div>
  <Terminal title="devlanes / myapp">
    <TerminalTabs
      label="TUI screens"
      tabs={[
        { id: 'monitor-units', label: 'monitor' },
        { id: 'monitor-lanes', label: 'lane view' }
      ]}
    />
    <div id="monitor-units" class="tui">
      <div class="tui-top">
        <strong>devlanes</strong>
        <span>1 myapp</span>
        <span class="tui-keys">
          <b>M</b> monitor <b>D</b> daemon
        </span>
      </div>
      <div class="tui-lanes">
        <span>
          <span class="tui-dim">cpu</span> <span class="state-ready">{spark}</span> {cpu.toFixed(0)}
          %
        </span>
        <span>
          <span class="tui-dim">mem</span> {(mem / 1024).toFixed(1)}G
        </span>
      </div>
      <div class="tui-pane">
        <p class="tui-title">
          units {count} of {count} · by lane <span class="tui-dim tui-hint">&lt;- cpu -&gt;</span>
        </p>
        <div
          class="table-scroll"
          role="region"
          aria-label="Units by lane, scroll horizontally for all columns"
          tabindex="0"
        >
          <table class="monitor-table">
            <thead>
              <tr>
                <th>name</th>
                <th>state</th>
                <th>cpu ▼</th>
                <th>mem</th>
                <th>uptime</th>
              </tr>
            </thead>
            {running.map(({ index, branch, units }) => (
              <tbody>
                <tr class="monitor-lane">
                  <th scope="rowgroup">
                    ▾ myapp@{index} <span>{branch}</span>
                  </th>
                  <td />
                  <td>{total(units, 'cpu').toFixed(1)}%</td>
                  <td>{total(units, 'mem')}M</td>
                  <td />
                </tr>
                {sorted(units).map((unit) => (
                  <tr class={index === 3 && unit.name === 'api' ? 'tui-selected' : undefined}>
                    <th scope="row">
                      <span class={`state-${unit.state}`}>
                        {unit.state === 'ready' ? '●' : '◉'}
                      </span>{' '}
                      {unit.name}
                    </th>
                    <td>{unit.state}</td>
                    <td>
                      {unit.cpu.toFixed(1)}%{' '}
                      <span class="bar" aria-hidden="true">
                        <i>{'■'.repeat(bar(unit.cpu, 40))}</i>
                        {'■'.repeat(4 - bar(unit.cpu, 40))}
                      </span>
                    </td>
                    <td>
                      {unit.mem}M{' '}
                      <span class="bar" aria-hidden="true">
                        <i>{'■'.repeat(bar(unit.mem, 300))}</i>
                        {'■'.repeat(4 - bar(unit.mem, 300))}
                      </span>
                    </td>
                    <td>{unit.uptime}</td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </div>
      <div class="terminal-foot">
        j k move <span>enter open unit</span> <span>&lt; &gt; sort</span> <span>/ filter</span>
        <span>? all keys</span> <span>q quit</span>
      </div>
    </div>
    <div id="monitor-lanes" hidden>
      <LaneView lane={3} unit="web" />
    </div>
  </Terminal>
</section>
