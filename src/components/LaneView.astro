---
// The TUI's lane view: lanes bar, the selected lane's unit tree and the selected unit's
// terminal. Text and keys follow devlanes' screen snapshots (crates/tui/screens/lanes-unit-*).
import { lanes, port, type Unit } from '../data/demo';

interface Props {
  lane: number;
  unit: Unit['name'];
}
const { lane: index, unit: selected } = Astro.props;
const lane = lanes[index];
if (!lane) throw new Error(`No demo lane ${index}`);
const unit = lane.units.find((item) => item.name === selected);

const output = {
  api: [
    '> myapp-api dev',
    `listening on :${port(index, 'api')}`,
    'GET /checkout 200 4ms',
    'POST /orders 201 12ms',
    'GET /orders/1042 200 3ms'
  ],
  web: [
    '> myapp-web dev',
    'VITE ready in 412 ms',
    `Local: http://127.0.0.1:${port(index, 'web')}/`,
    'page reload src/routes/checkout.tsx'
  ],
  worker: ['> myapp-worker dev', 'waiting for jobs on queue default', 'job 381 send-receipt done']
}[selected];
---

<div class="tui">
  <div class="tui-top">
    <strong>devlanes</strong>
    <span class="tui-current">1 myapp</span>
    <span class="tui-keys">
      <b>M</b> monitor <b>D</b> daemon
    </span>
  </div>
  <div class="tui-lanes">
    <span class="tui-dim">lanes</span>
    {lanes.map((item) => (
      <span class={item.index === index ? 'tui-current' : undefined}>
        {item.index + 1} {item.branch}
      </span>
    ))}
  </div>
  <div class="tui-panes">
    <div class="tui-pane tui-tree">
      <p class="tui-title">
        @{index} · {lane.units.length}/{lane.units.length} up
      </p>
      <ul>
        <li class="tui-dim">
          ▾ services <span>{lane.units.length}</span>
        </li>
        {lane.units.map((item) => (
          <li class={item.name === selected ? 'tui-selected' : undefined}>
            <span class={`state-${item.state}`}>{item.state === 'ready' ? '●' : '◉'}</span>{' '}
            {item.name}
          </li>
        ))}
      </ul>
    </div>
    <div class="tui-pane tui-output">
      <p class="tui-title">
        {selected} <span class={`state-${unit?.state}`}>{unit?.state}</span>
        <span class="tui-dim tui-hint">watching · enter types</span>
      </p>
      {output.map((line) => (
        <p>{line}</p>
      ))}
    </div>
  </div>
  <div class="terminal-foot">
    enter type into it <span>x stop</span> <span>r restart</span> <span>o open in browser</span>
    <span>? all keys</span> <span>q quit</span>
  </div>
</div>
