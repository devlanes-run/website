---
// The two buttons follow GitHub's own button styling, star and heart icons included, so they
// read as GitHub actions rather than page buttons.
---

<section id="open-source" class="open-source" aria-labelledby="open-source-title">
  <h2 id="open-source-title">
    <a class="fold-anchor" href="#open-source">
      Free and open source
    </a>
  </h2>
  <p>
    devlanes is Apache-2.0. It is a CLI and a daemon that run where your shell runs: no account, no
    hosted service, nothing phones home. Written in Rust, for macOS, Linux and Windows 11. The
    source, the issues and the releases are on GitHub.
  </p>
  <div class="gh-buttons">
    <a
      class="gh-button"
      href="https://github.com/devlanes-run/devlanes"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"
        ></path>
      </svg>
      Star
      <span class="gh-count" data-gh-stars hidden></span>
    </a>
    <a
      class="gh-button gh-sponsor"
      href="https://github.com/sponsors/arthurfiorette"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="m8 14.25.345.666a.75.75 0 0 1-.69 0l-.008-.004-.018-.01a7.152 7.152 0 0 1-.31-.17 22.055 22.055 0 0 1-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22.066 22.066 0 0 1-3.744 2.584l-.018.01-.006.003h-.002ZM4.25 2.5c-1.336 0-2.75 1.164-2.75 3 0 2.15 1.58 4.144 3.365 5.682A20.58 20.58 0 0 0 8 13.393a20.58 20.58 0 0 0 3.135-2.211C12.92 9.644 14.5 7.65 14.5 5.5c0-1.836-1.414-3-2.75-3-1.373 0-2.609.986-3.029 2.456a.749.749 0 0 1-1.442 0C6.859 3.486 5.623 2.5 4.25 2.5Z"
        ></path>
      </svg>
      Sponsor
    </a>
  </div>
</section>

<script>
  // The star count comes from GitHub's API; without it the button is just "Star".
  const count = document.querySelector<HTMLElement>('[data-gh-stars]');
  if (count) {
    fetch('https://api.github.com/repos/devlanes-run/devlanes')
      .then((response) => (response.ok ? response.json() : undefined))
      .then((repo: { stargazers_count?: number } | undefined) => {
        // A small count says the opposite of what the button is for.
        if (typeof repo?.stargazers_count !== 'number' || repo.stargazers_count < 100) return;
        count.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(
          repo.stargazers_count
        );
        count.hidden = false;
      })
      .catch(() => {});
  }
</script>
